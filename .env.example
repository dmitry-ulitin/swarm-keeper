# Local development only. Copy to .env just to override a default; never commit .env.
# Every value below is the default the infra scripts and compose.yaml already use.

NODE_ENV=development
PORT=3000

# PostgreSQL (compose service "postgres")
POSTGRES_USER=swarm
POSTGRES_PASSWORD=swarm
POSTGRES_DB=swarm_keeper
POSTGRES_PORT=5432
DATABASE_URL=postgres://swarm:swarm@127.0.0.1:5432/swarm_keeper

# S3-compatible storage (compose service "garage")
S3_PORT=3900
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=swarm-keeper
S3_ACCESS_KEY_ID=GKec20a5351a7e7b4b01dffdad
S3_SECRET_ACCESS_KEY=2bbb10b202e463b4f75fa68c5fac50a71ca86e057c749d56630f5a391faf27b0

# Better Auth (apps/api). Production must set BETTER_AUTH_SECRET (openssl rand -base64 32)
# and BETTER_AUTH_URL; the API refuses to start without them.
BETTER_AUTH_SECRET=dev-only-swarm-keeper-auth-secret-0123456789
# The origin the browser sees; in dev the web app on 4200 proxies /api to the API.
BETTER_AUTH_URL=http://localhost:4200
# WebAuthn relying party ID: the app's domain.
PASSKEY_RP_ID=localhost

# pnpm db:seed: the first owner and family (no defaults; the seed refuses empty values).
# SEED_OWNER_EMAIL=owner@example.test
# SEED_OWNER_PASSWORD=
# SEED_FAMILY_NAME=
