# Local development only. Copy to .env just to override a default; never commit .env.
# Every value below is the default the infra scripts and compose.yaml already use.

NODE_ENV=development
PORT=3000

# PostgreSQL (compose service "postgres")
POSTGRES_USER=swarm
POSTGRES_PASSWORD=swarm
POSTGRES_DB=swarm_keeper
POSTGRES_PORT=5432
# The API, worker and CLI connect as the application role (pnpm db:roles creates it in dev);
# migrations and codegen connect as the schema owner.
DATABASE_URL=postgres://swarm_app:swarm_app@127.0.0.1:5432/swarm_keeper
DATABASE_OWNER_URL=postgres://swarm:swarm@127.0.0.1:5432/swarm_keeper

# S3-compatible storage (compose service "garage")
S3_PORT=3900
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=swarm-keeper
S3_ACCESS_KEY_ID=GKec20a5351a7e7b4b01dffdad
S3_SECRET_ACCESS_KEY=2bbb10b202e463b4f75fa68c5fac50a71ca86e057c749d56630f5a391faf27b0

# Mail (compose service "mailpit"): auth emails land in the web UI at http://127.0.0.1:8025.
# SMTP_URL and MAIL_FROM have these defaults only when NODE_ENV is development or test.
SMTP_PORT=1025
MAILPIT_PORT=8025
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Swarm Keeper <noreply@swarm-keeper.test>"

# API listen address. Loopback by default: Better Auth reads the client IP from
# x-forwarded-for, so only the reverse proxy may reach the API.
HOST=127.0.0.1

# Better Auth (apps/api). The defaults below apply only when NODE_ENV is development or test;
# with any other NODE_ENV (or none) the API refuses to start without real values.
# BETTER_AUTH_SECRET: at least 32 characters (openssl rand -base64 32), never the dev value.
BETTER_AUTH_SECRET=dev-only-swarm-keeper-auth-secret-0123456789
# The origin the browser sees; in dev the web app on 4200 proxies /api to the API.
BETTER_AUTH_URL=http://localhost:4200
# WebAuthn relying party ID: the app's domain.
PASSKEY_RP_ID=localhost
# Proxies allowed to append to x-forwarded-for (comma-separated IPs or CIDRs). Leave empty
# when the proxy overwrites the header with the client address.
TRUSTED_PROXIES=

# pnpm db:seed: the first owner and family (no defaults; the seed refuses empty values).
# SEED_OWNER_EMAIL=owner@example.test
# SEED_OWNER_PASSWORD=
# SEED_FAMILY_NAME=

# pnpm family:create / family:invite-owner: the inviter, i.e. the operator's own verified account.
# OPERATOR_EMAIL=owner@example.test
