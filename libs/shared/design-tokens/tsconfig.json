{
  "extends": "../../../tsconfig.base.json",
  // Compiled into the API and worker under nodenext as well:
  // relative imports need .js suffixes.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // build/generate.ts runs directly under Node, which needs the .ts suffix; never emitted.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "build/**/*.ts", "vitest.config.ts"]
}
