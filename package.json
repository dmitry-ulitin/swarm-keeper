{
  "name": "swarm-keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @swarm-keeper/web-e2e e2e",
    "lint": "eslint . && pnpm i18n:check",
    "i18n:check": "pnpm --filter @swarm-keeper/i18n-check check ../../apps/web/src/i18n && pnpm --filter @swarm-keeper/web i18n:find",
    "format": "prettier --write .",
    "tokens:build": "pnpm --filter @swarm-keeper/design-tokens build",
    "db:migrate": "pnpm --filter @swarm-keeper/api db:migrate",
    "db:migrate:down": "pnpm --filter @swarm-keeper/api db:migrate:down",
    "db:new": "pnpm --filter @swarm-keeper/api db:new",
    "db:types": "pnpm --filter @swarm-keeper/api db:types",
    "db:seed": "pnpm --filter @swarm-keeper/api db:seed",
    "db:roles": "pnpm --filter @swarm-keeper/api db:roles",
    "family:create": "pnpm --filter @swarm-keeper/api family create",
    "family:invite-owner": "pnpm --filter @swarm-keeper/api family invite-owner",
    "family:list": "pnpm --filter @swarm-keeper/api family list",
    "infra:up": "docker compose up -d --wait --wait-timeout 60 && sh infra/dev/garage-init.sh && pnpm db:roles",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "infra:check": "sh infra/dev/check.sh",
    "icons:build": "node libs/web/ui/scripts/build-icons.mjs && prettier --write libs/web/ui/src/icons/icons.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sheriff-arch/eslint-plugin-sheriff": "0.21.1",
    "@sheriff-arch/sheriff-core": "0.21.1",
    "@types/node": "catalog:",
    "@typescript-eslint/utils": "8.73.0",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.73.0"
  }
}
