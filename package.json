{
  "name": "swarm-keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tokens:build": "pnpm --filter @swarm-keeper/design-tokens build",
    "db:migrate": "pnpm --filter @swarm-keeper/api db:migrate",
    "db:migrate:down": "pnpm --filter @swarm-keeper/api db:migrate:down",
    "db:new": "pnpm --filter @swarm-keeper/api db:new",
    "db:types": "pnpm --filter @swarm-keeper/api db:types",
    "db:seed": "pnpm --filter @swarm-keeper/api db:seed",
    "infra:up": "docker compose up -d --wait --wait-timeout 60 && sh infra/dev/garage-init.sh",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "infra:check": "sh infra/dev/check.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sheriff-arch/eslint-plugin-sheriff": "0.21.1",
    "@sheriff-arch/sheriff-core": "0.21.1",
    "@types/node": "catalog:",
    "@typescript-eslint/utils": "8.73.0",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.73.0"
  }
}
