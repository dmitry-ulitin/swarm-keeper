{
  "name": "@swarm-keeper/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "kysely --no-outdated-check migrate latest",
    "db:migrate:down": "kysely --no-outdated-check migrate down",
    "db:new": "kysely --no-outdated-check migrate make",
    "db:types": "kysely-codegen --dialect postgres --camel-case --url \"${DATABASE_URL:-postgres://swarm:swarm@127.0.0.1:5432/swarm_keeper}\" --out-file src/database/schema.ts",
    "db:seed": "pnpm build && node dist/apps/api/src/seed.js"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@swarm-keeper/permissions": "workspace:*",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "7.2.1",
    "auth": "1.7.27",
    "kysely-codegen": "0.20.0",
    "kysely-ctl": "0.22.0",
    "supertest": "7.3.2",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
